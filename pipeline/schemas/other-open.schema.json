{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sources/businesses/other-open.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "url", "licence", "licence_url", "redistribution", "verified"],
        "properties": {
          "redistribution": {"enum": ["package", "direct-download", "excluded"]},
          "licence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
