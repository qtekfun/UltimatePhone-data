{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sources/businesses/osm.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "name", "licence", "licence_url", "attribution", "redistribution",
               "max_alternatives", "tags", "regions"],
  "properties": {
    "source_id": {"type": "string"}, "name": {"type": "string"},
    "licence": {"const": "ODbL-1.0"}, "licence_url": {"type": "string"},
    "attribution": {"type": "string", "minLength": 1},
    "redistribution": {"const": "package"},
    "max_alternatives": {"type": "integer", "minimum": 0, "maximum": 10},
    "tags": {
      "type": "object", "additionalProperties": false, "required": ["phone_keys", "business_keys"],
      "properties": {
        "phone_keys": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "business_keys": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "regions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "country", "name", "extracts"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]{2}(-[A-Z0-9]+)?$"},
          "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "name": {"type": "string"},
          "extracts": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://.+\\.osm\\.pbf$"}}
        }
      }
    }
  }
}
