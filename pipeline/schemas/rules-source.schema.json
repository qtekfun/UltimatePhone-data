{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sources/rules/*.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["country", "rules"],
  "properties": {
    "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prefix", "level", "kind", "source", "note"],
        "properties": {
          "id": {"type": "string"},
          "prefix": {"type": "string"},
          "level": {"const": "RULE"},
          "kind": {"enum": ["commercial", "premium", "other"]},
          "source": {"type": "string"},
          "source_url": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
