{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UltimatePhone prefix rules pack, schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "rules"],
  "properties": {
    "schema": {"const": 1},
    "version": {"type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "country", "prefix", "level", "kind", "source", "note"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "prefix": {"type": "string", "pattern": "^[0-9]+$"},
          "level": {"const": "RULE"},
          "kind": {"enum": ["commercial", "premium", "other"]},
          "source": {"type": "string", "minLength": 1},
          "sourceUrl": {"type": "string", "pattern": "^https://"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
